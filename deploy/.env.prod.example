# Copie ce fichier vers /opt/transaction-pipeline/.env.prod sur la VM,
# puis remplace les deux valeurs de démonstration par des secrets uniques.
POSTGRES_DB=transactions
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_LONG
RUSTFS_ACCESS_KEY=pipeline-access
RUSTFS_SECRET_KEY=REMPLACER_PAR_UN_SECRET_LONG
S3_BUCKET=transactions
POLL_SECONDS=60
